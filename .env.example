# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# PostgreSQL (single-user MVP). Keep credentials out of source control.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jobhunter?schema=public"

# Prisma shadow database (used by `prisma migrate dev`). Must be an existing,
# empty database the configured user can drop/recreate objects in.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jobhunter_shadow?schema=public"

# Integration tests run against a real database and TRUNCATE it between cases. Required:
# tests never fall back to DATABASE_URL, and the database name must end in `_test`, because
# the name is the only evidence the database is disposable (tests/support/db.ts).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jobhunter_test?schema=public"

# AI provider — noop is the default and must keep the pipeline useful.
AI_PROVIDER="noop"

# API process (SRS 3.4). Loopback by default: the API binds 127.0.0.1 and answers only local
# hostnames, so it is not a network service (ADR-0007, ADR-0011).
# API_HOST="127.0.0.1"
# API_PORT="3001"
# LOG_LEVEL="info"  # Fastify log level for the API process (read in apps/api/main.ts)

# Signing key for local sign-in codes and API bearer credentials (SRS 8.1/8.3; ADR-0011).
# REQUIRED: without it the API cannot tell a proven identity from a claimed one, so it refuses to
# start rather than answer anonymously. At least 32 bytes, treated like a database password, and
# never committed or logged. Rotating it invalidates every credential minted with the old one.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=""

# Reaching the API from anywhere but loopback is a decision of its own, so it takes two
# acknowledgements: the bind, and the exact hostnames it may answer for in `Host`. Without the
# second one no address check is possible and a DNS-rebound page would be served as if it were
# local. JobHunter still serves plain HTTP: put TLS in front of it yourself.
# API_ALLOW_EXTERNAL_BIND="false"
# API_ALLOWED_HOSTS=""        # e.g. "jobs.internal.example"

# Worker process (SRS 7.6/9.5). The two bounds below are required and have no default - they
# decide when an abandoned run and a hanging acquisition are given up on, and a guess would
# turn a safety decision into an accident. The worker refuses to start without them.
#
# The acquisition bound must outlast the slowest real run, not merely satisfy the worker's own
# validation: a full EffoySira run measures 50-70 s on the collection host (docs/sources/effoysira.md),
# so a bound tuned only to be "shorter than the stale window" fails every run of that source.
# These are the pair observed working live.
# SOURCE_STALE_RUN_SECONDS="900"
# SOURCE_ACQUISITION_TIMEOUT_MS="300000"

# Worker tuning. All optional; each falls back to the default the worker documents.
# WORKER_LEASE_SECONDS="60"
# WORKER_HEARTBEAT_MS="20000"
# WORKER_POLL_INTERVAL_MS="1000"
# WORKER_REAPER_INTERVAL_MS="30000"
# SOURCE_SCHEDULER_INTERVAL_MS="30000"
# WORKER_ID=""  # defaults to host:pid

# Telegram delivery (SRS 3.2/3.4; the notification loop, ADR-0008). The WORKER reads the
# token; the API reads only the public bot username (to render the deep link). Without the
# token the worker runs but does not dispatch: reserved notifications stay PENDING instead of
# being marked delivered by anything that cannot reach Telegram.
# TELEGRAM_BOT_TOKEN=""          # Telegram Bot API credential (worker only; NEVER commit it)
# TELEGRAM_BOT_USERNAME=""       # e.g. jobhunterethiobot (API only; used for the t.me deep link)
# NOTIFICATION_DISPATCH_INTERVAL_MS="30000"  # outbox sweep cadence (optional)

# Backups (FR-021, AC-019). `npm run backup` writes a compressed pg_dump archive to
# `backups/` (git-ignored) by default; `BACKUP_DIR` should point outside the repo on a
# different disk. `BACKUP_COPY_DIR` adds a byte-verified second copy elsewhere - it must be
# outside the repository and differs in purpose from BACKUP_DIR, which only relocates the first.
# Archives contain candidate and notification data: keep them encrypted and
# off-machine. PostgreSQL's bin directory is auto-detected on Windows; set `PG_BIN` when the
# client tools live elsewhere or PATH should be used explicitly. The client tools must match
# the server's major version.
# BACKUP_DIR="D:/jobhunter-backups"
# BACKUP_COPY_DIR="E:/jobhunter-copies"
# PG_BIN="C:/Program Files/PostgreSQL/16/bin"

