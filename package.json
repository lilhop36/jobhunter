{
  "name": "jobhunting",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "verify": "tsc --noEmit && vitest --run",
    "test": "vitest",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:failure": "vitest --run tests/failure",
    "test:ci": "vitest --run"
  },
  "devDependencies": {
    "@types/node": "20.17.0",
    "@vitest/coverage-v8": "2.1.9",
    "prisma": "5.22.0",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}
