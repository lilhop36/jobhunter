{
  "name": "jobhunting",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:failure": "vitest --run tests/failure",
    "test:ci": "vitest --run"
  },
  "engines": {
    "node": ">=20"
  }
}
