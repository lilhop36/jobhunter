{
  "name": "jobhunting",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "src"
  ],
  "scripts": {
    "build": "tsc --build && tsc-alias",
    "start:api": "node --env-file=.env dist/apps/api/main.js",
    "start:worker": "node --env-file=.env dist/apps/worker/main.js",
    "dev:api": "node --env-file=.env --watch --import tsx apps/api/main.ts",
    "dev:worker": "node --env-file=.env --watch --import tsx apps/worker/main.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "verify": "node scripts/check-disk-space.mjs && tsc --noEmit && vitest --run",
    "test": "vitest",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:failure": "vitest --run tests/failure",
    "seed:sources": "node --env-file=.env scripts/seed-sources.mjs",
    "seed:candidate": "node --env-file=.env --import tsx scripts/seed-candidate.ts",
    "telegram:resolve": "node --env-file=.env --import tsx scripts/telegram-resolve.ts",
    "test:ci": "vitest --run"
  },
  "devDependencies": {
    "@types/node": "20.17.0",
    "@vitest/coverage-v8": "2.1.9",
    "prisma": "5.22.0",
    "tsc-alias": "1.9.7",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "fastify": "^4.28.1"
  }
}
