// JobHunter v1.0 — Prisma schema (Milestone 1: ingestion data model)
//
// Source of truth: docs/SRS/JobHunter-v1.1-SRS.md
//   - 5.2 Entity Attributes (JobSource, SourceRun, RawJob, Job, SystemLog)
//   - 5.6 Database Requirements
//   - 7.5 Durable work and locking
//
// NOTE: `one_active_run_per_source` (partial unique index) and the work-queue
// claim helpers are NOT expressible in the Prisma schema. They live in
// prisma/migrations/**/migration.sql as raw SQL. Do not let `prisma migrate`
// drop them: review generated SQL before applying.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (mirror src/domain/enums/*)
// ---------------------------------------------------------------------------

enum LifecycleStatus {
  ACTIVE
  EXPIRED
  REMOVED
  NOT_FOUND
}

enum CalendarType {
  GREGORIAN
  ETHIOPIAN
  UNKNOWN
}

enum SalaryType {
  EXACT
  RANGE
  STARTING_FROM
  UP_TO
  NEGOTIABLE
  NOT_DISCLOSED
  AS_PER_SCALE
  UNKNOWN
}

enum SalaryPeriod {
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
  OTHER
  UNKNOWN
}

enum LocationCategory {
  ADDIS_ABABA
  ETHIOPIA_CITY
  ETHIOPIA_REGION
  ETHIOPIA_REMOTE
  INTERNATIONAL_REMOTE
  INTERNATIONAL_ON_SITE
  HYBRID
  UNKNOWN
}

enum EvidenceState {
  KNOWN
  UNKNOWN
  CONFLICTING
}

enum SkillEvidence {
  EXACT_MATCH
  CANONICAL_ALIAS
  RELATED_SKILL
  TRANSFERABLE
  AI_SUGGESTED
  UNKNOWN
}

enum AIStatus {
  SUCCESS
  TIMEOUT
  UNAVAILABLE
  INVALID_OUTPUT
  SCHEMA_ERROR
  PROVIDER_ERROR
  FALLBACK
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

/// SRS 4.8 / FR-018 feedback values: "relevant/not relevant/unsure".
enum NotificationFeedbackValue {
  RELEVANT
  NOT_RELEVANT
  UNSURE
}

enum ApplicationMethod {
  ONLINE_URL
  EMAIL
  SOURCE_ACCOUNT
  PDF_FORM
  IN_PERSON
  INSTRUCTIONS
  UNKNOWN
}

enum DescriptionQuality {
  SUFFICIENT
  PARTIAL
  UNUSABLE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  FREELANCE
  UNKNOWN
}

enum RemoteStatus {
  ONSITE
  REMOTE
  HYBRID
  UNKNOWN
}

enum ProvenanceSource {
  SOURCE
  DETERMINISTIC
  AI
}

/// SRS 5.2 lists `CandidateProfile.remotePreference` but defines no value set; these four
/// are engineering-owned (ADR-0005). Only the two *exclusive* states penalize a
/// contradicting posting; `NO_PREFERENCE` is the truthful "not stated" value.
enum RemotePreference {
  REMOTE_REQUIRED
  REMOTE_PREFERRED
  NO_PREFERENCE
  ONSITE_ONLY
}

/// SRS 5.2 lists `CandidateProfile.relocationPreference` but defines no value set
/// (ADR-0005). `UNDECIDED` is the truthful "not stated" value and never implies willingness.
enum RelocationPreference {
  WILLING
  NOT_WILLING
  UNDECIDED
}

// Engineering-owned state machines (not defined in the SRS).
enum HealthStatus {
  HEALTHY
  DEGRADED
  FAILING
  UNKNOWN
}

enum SourceRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

enum SourceRunTrigger {
  SCHEDULE
  MANUAL
  STARTUP
}

enum WorkTaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

// ---------------------------------------------------------------------------
// M1 tables
// ---------------------------------------------------------------------------

model JobSource {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String       @unique
  adapterType         String
  adapterVersion      String
  enabled             Boolean      @default(true)
  accessPolicy        Json?
  schedule            String?
  healthStatus        HealthStatus @default(UNKNOWN)
  lastSuccessfulRunAt DateTime?
  lastErrorAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  runs SourceRun[]
  raw  RawJob[]
  jobs Job[]

  @@map("job_sources")
}

model SourceRun {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId              String           @db.Uuid
  status                SourceRunStatus  @default(RUNNING)
  trigger               SourceRunTrigger @default(SCHEDULE)
  startedAt             DateTime         @default(now())
  finishedAt            DateTime?
  durationMs            Int?
  jobsDiscovered        Int              @default(0)
  jobsAccepted          Int              @default(0)
  jobsDuplicate         Int              @default(0)
  jobsRejected          Int              @default(0)
  undeduplicable        Int              @default(0)
  fallbackIdentities    Int              @default(0)
  parseFailures         Int              @default(0)
  httpFailures          Int              @default(0)
  unexpectedZeroResults Boolean          @default(false)
  /// SRS 7.7 step 10 ("schedule enrichment/matching work"). Engineering-owned
  /// observability, like the counters: the enrichment/matching stage has no registered
  /// handler yet, so the hand-off cannot be enqueued. Recording it per run makes the
  /// deferral an explicit state instead of an implicit gap behind a SUCCEEDED status.
  /// `false` means the run did not schedule downstream work.
  enrichmentScheduled   Boolean          @default(false)
  errorSummary          String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  source  JobSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  rawJobs RawJob[]
  tasks   WorkTask[]

  @@index([sourceId, startedAt])
  @@map("source_runs")
}

model RawJob {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId             String   @db.Uuid
  sourceRunId          String?  @db.Uuid
  /// Deduplication scope is intentionally not a plain @unique: a capture is identified
  /// by source + identifier + content hash, and only when an identifier exists. Two
  /// hand-written partial unique indexes (`one_raw_observation_per_identifier`,
  /// `one_raw_observation_per_content`) enforce it because Prisma cannot express partial
  /// indexes. Keep in sync with the ON CONFLICT targets in PrismaRawJobRepository.
  sourceJobIdentifier  String?
  sourceUrl            String?
  rawTitle             String?
  rawCompany           String?
  rawLocation          String?
  rawDescription       String?
  rawPublishedDateText String?
  rawSalaryText        String?
  rawPayload           Json?
  /// Versioned SHA-256 of the captured raw fields (`rawContentHash` in
  /// @domain/normalizers/job-identity). Derived, never supplied by the source.
  contentHash          String
  collectedAt          DateTime @default(now())
  /// Last observed by the collection process - never the source's content-update time.
  /// Written only by collection, which produces the row, so this does not mutate source
  /// evidence (ENG-002 constrains *downstream* stages).
  lastSeenAt           DateTime @default(now())
  createdAt            DateTime @default(now())

  source    JobSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceRun SourceRun? @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  jobs      Job[]

  @@index([sourceId, sourceJobIdentifier])
  @@index([sourceRunId])
  @@map("raw_jobs")
}

model Job {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId                  String              @db.Uuid
  rawJobId                  String?             @db.Uuid
  /// Source-scoped source-record identity (ADR-0001), computed by the domain layer from
  /// the raw record. NOT NULL: a Job exists only for a record whose identity resolved,
  /// so undeduplicable evidence is counted but never promoted. Never a cross-source
  /// canonical identity - that stays deferred to ENG-005, and the unique index below
  /// includes sourceId precisely so the same key in two sources stays two Jobs.
  identityKey               String
  canonicalUrl              String?
  title                     String?
  company                   String?
  description               String?
  descriptionQuality        DescriptionQuality
  locationText              String?
  locationCategory          LocationCategory    @default(UNKNOWN)
  publishedCalendar         CalendarType        @default(UNKNOWN)
  originalPublishedDateText String?
  publishedAt               DateTime?
  dateConfidence            Decimal?            @db.Decimal(4, 3)
  salaryType                SalaryType          @default(UNKNOWN)
  salaryMin                 Decimal?            @db.Decimal(14, 2)
  salaryMax                 Decimal?            @db.Decimal(14, 2)
  salaryCurrency            String?
  salaryPeriod              SalaryPeriod        @default(UNKNOWN)
  salaryEvidence            String?
  salaryConfidence          Decimal?            @db.Decimal(4, 3)
  employmentType            EmploymentType      @default(UNKNOWN)
  remoteStatus              RemoteStatus        @default(UNKNOWN)
  applicationMethod         ApplicationMethod   @default(UNKNOWN)
  applyUrl                  String?
  applyEmail                String?
  lifecycleStatus           LifecycleStatus     @default(ACTIVE)
  contentFingerprint        String?
  // Per-field origin map: field name -> { provenance, conversionMethod, evidence }
  // (SRS ENG-003 / Appendix E). Written by the ingestion pipeline.
  provenance                Json?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  source JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  rawJob RawJob?   @relation(fields: [rawJobId], references: [id], onDelete: SetNull)
  matches JobMatch[]
  notifications NotificationOutbox[]

  // SRS 5.6 database requirements.
  @@index([canonicalUrl])
  @@index([contentFingerprint])
  @@index([sourceId, lifecycleStatus])
  @@index([publishedAt])
  // One Job per source-scoped identity. Plain (never partial): a partial index over a
  // nullable column would accept repeated NULLs and stop preventing promotion of
  // identity-less Jobs. The name is fixed to match the hand-written migration index.
  @@unique([sourceId, identityKey], map: "one_job_per_source_identity")
  @@map("jobs")
}

model WorkTask {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           String
  payload        Json?
  /// Deduplication scope is intentionally not a plain @unique: uniqueness only
  /// applies while a task is PENDING or RUNNING. A hand-written partial unique
  /// index (`one_active_task_per_dedupe_key`) enforces it because Prisma cannot
  /// express partial indexes. Keep in sync with ACTIVE_WORK_TASK_STATUSES.
  dedupeKey      String?
  status         WorkTaskStatus @default(PENDING)
  priority       Int            @default(0)
  attempts       Int            @default(0)
  maxAttempts    Int            @default(5)
  runAfter       DateTime       @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  /// Unique token minted per claim. Heartbeat/complete/fail must present it so a
  /// worker whose lease was reclaimed cannot mutate a newer attempt.
  leaseToken     String?        @unique
  leaseExpiresAt DateTime?
  sourceRunId    String?        @db.Uuid
  lastError      String?
  lastErrorAt    DateTime?
  createdAt      DateTime       @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  updatedAt      DateTime       @updatedAt

  sourceRun SourceRun? @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)

  @@index([status, runAfter, priority])
  @@index([leaseExpiresAt])
  @@map("work_tasks")
}

// ---------------------------------------------------------------------------
// M2 tables: the candidate matching profile (SRS 4.5, 5.2; FR-012)
//
// Milestone 2 is "seeded candidate" + matcher. These tables hold what the
// candidate *declared*; nothing here is derived from postings, and a value the
// candidate never stated is NULL or an empty list rather than a guess (ENG-001).
// ---------------------------------------------------------------------------

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String @unique
  /// SRS 5.2 lists `role` and `status` but Appendix A defines no value set for either, so
  /// they are plain strings with the documented v1 defaults and become enums when
  /// authentication lands. `passwordHash` is deliberately absent: the SRS makes it
  /// conditional on password auth, and the v1 interface is Telegram deep-link linking
  /// (SRS 3.2).
  role   String @default("OWNER")
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile CandidateProfile?
  jobMatches JobMatch[]
  notifications NotificationOutbox[]
  telegramLinkTokens TelegramLinkToken[]
  telegramDestination TelegramDestination?

  @@map("users")
}

/// SRS 3.2 "Linking": `POST /api/telegram/link` issues one of these, and the user it names
/// frees the destination only after Telegram itself delivers the token back via the deep link
/// (`t.me/<bot>?start=<token>`). The token is not private-profile data: the row stores only the
/// user it was issued for, and never the plaintext, so a database leak cannot mint valid links
/// (SRS 8.3). Short-lived: rows past `expiresAt` cannot resolve anything and are inert.
model TelegramLinkToken {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  /// SHA-256 hex of the one-time token. Unique because the hash, not the id, is the lookup key.
  tokenHash String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  /// Consumed by the token's one permitted resolution; the deep link stops working here even
  /// before expiry, which is what makes the token single-use.
  usedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_link_tokens")
}

/// SRS 2.2/2.4: one seeded candidate owns one Telegram destination. The chat id arrives only
/// after the token is resolved, so nothing here can be guessed or harvested (SRS 8.3).
model TelegramDestination {
  /// Primary key on the user: linking again records the same user's new destination rather
  /// than accumulating contradicting rows.
  userId String @id @db.Uuid
  /// Telegram chat id as text: ids can exceed 32 bits (bigint) and be negative (channels and
  /// groups), and text matches the decimal form that appears on the Telegram wire.
  chatId String
  linkedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_destinations")
}

model CandidateProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @db.Uuid

  experienceYears Int?
  remotePreference RemotePreference
  relocationPreference RelocationPreference
  /// SRS 5.2 lists `employmentPreferences` as a profile attribute (plural), so it is an
  /// array rather than a join table. An empty array means "not stated".
  employmentPreferences EmploymentType[]
  /// SRS 5.2 names `salaryPreference` as one attribute; it is modelled as its four
  /// columns (ENG-006: money as exact decimal, never float). "No salary preference" is
  /// the all-absent combination, which `PrismaCandidateProfileRepository` maps back to
  /// `null` — see the mapping table there.
  salaryMin              Decimal?      @db.Decimal(14, 2)
  salaryCurrency         String?
  salaryPeriod           SalaryPeriod?
  salaryRequireDisclosed Boolean       @default(false)
  /// Content-derived revision of the profile (`profileVersionOf` in
  /// @domain/matching/profile-version). A JobMatch records the revision it was scored
  /// against, so a later profile edit cannot silently reinterpret a stored match
  /// (ENG-012/ENG-013).
  profileVersion String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  skills              CandidateSkill[]
  targetRoles         TargetRole[]
  locationPreferences LocationPreference[]

  @@map("candidate_profiles")
}

model CandidateSkill {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateProfileId String @db.Uuid
  canonicalSkill     String
  /// SRS 5.2 `CandidateSkill.skillType`. The SRS names the attribute but no enum for it,
  /// so the Appendix A skill-evidence ladder is reused (ADR-0005 §7).
  skillType  SkillEvidence
  /// How firmly the candidate holds the skill, in [0, 1]; weights its match credit.
  confidence Decimal       @db.Decimal(4, 3)
  createdAt  DateTime      @default(now())

  /// SRS 5.6 "Recommended indexes": CandidateSkill(candidateProfileId, canonicalSkill)
  /// UNIQUE. Case-insensitive duplicate detection is enforced by the seed's validation
  /// rather than a functional index because the seed is the only write path; a
  /// case-insensitive constraint belongs here once profile editing exists.
  profile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([candidateProfileId, canonicalSkill], map: "one_candidate_skill_per_profile")
  @@map("candidate_skills")
}

model TargetRole {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateProfileId String @db.Uuid
  title              String
  /// Alternative spellings/titles meaning the same role. Empty means "none stated".
  aliases   String[]
  createdAt DateTime @default(now())

  profile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([candidateProfileId, title], map: "one_target_role_per_profile")
  @@map("target_roles")
}

model LocationPreference {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateProfileId String @db.Uuid
  category           LocationCategory
  /// Free-text place for a category the gazetteer cannot name; null means "category only".
  text      String?
  createdAt DateTime @default(now())

  profile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  /// PostgreSQL treats NULLs as distinct, so this catches duplicate (category, text)
  /// pairs but not two rows with the same category and no text. The seed's validation
  /// rejects the whole set case-insensitively; a total constraint is deferred until
  /// profile editing exists (same reasoning as CandidateSkill above).
  @@unique([candidateProfileId, category, text], map: "one_location_preference_per_profile")
  @@map("location_preferences")
}

model SystemLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level     String
  area      String
  message   String
  context   Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([area, createdAt])
  @@map("system_logs")
}

// ---------------------------------------------------------------------------
// M2 tables: deterministic match results (SRS 5.2 JobMatch, 5.6; FR-013..FR-015)
//
// This table is the *result* of matching, not an input: every column is derived
// by `scoreMatch` (a pure domain function) from the candidate profile and the
// normalized job, and nothing here is inferred from posting text (ENG-001).
// ---------------------------------------------------------------------------

model JobMatch {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  jobId  String @db.Uuid

  /// Relevance and confidence are different quantities (ENG-028, SRS 4.6 "Confidence");
  /// both are `Percent` [0, 100] (SRS B.3). `confidence` is never derived from `score`.
  score      Int
  confidence Int
  /// Per-factor scores (SRS 5.2 `roleScore` … `salaryScore`). NULL means the factor had no
  /// usable evidence and was *excluded* from the score and the denominator (SRS 4.6
  /// "UNKNOWN rule"), never that it scored zero (AC-010).
  roleScore       Int?
  skillScore      Int?
  experienceScore Int?
  locationScore   Int?
  employmentScore Int?
  freshnessScore  Int?
  salaryScore     Int?
  /// Versioned evidence document (`JobMatchEvidence`, SRS 5.2 `matchedEvidence` /
  /// `missingEvidence` / `uncertainEvidence`; FR-015). Typed and validated on read; the
  /// skill-named subset is carried structurally rather than re-parsed from the lines.
  evidence Json
  /// Deterministic, evidence-derived "why it matches" text, no AI and no free prose
  /// (FR-015, ENG-008).
  explanation String
  /// SRS 4.6 "Versioning": every JobMatch stores the matcher revision it was scored with
  /// (ENG-013). A scoring change requires a new value.
  matcherVersion String
  /// Engineering addition to SRS 5.2 (reported, not silently added): the profile revision
  /// this result was scored against, so a later profile edit cannot silently reinterpret a
  /// stored match (ENG-012/ENG-013).
  profileVersion String
  /// Engineering addition to SRS 5.2 (reported): sha256 over the canonical scoring inputs
  /// (profile revision + the job fields that feed scoring + matcher version). The injected
  /// clock is deliberately *excluded*, so a freshness-only change does not look like new
  /// inputs. Unique with (user, job, matcherVersion): a profile edit or a changed job
  /// produces a new row rather than overwriting history.
  inputHash String
  /// When this result was produced. Separate from `createdAt` because the clock is not an
  /// input to `inputHash`: a freshness-only re-score updates the output in place.
  scoredAt  DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  notifications NotificationOutbox[]

  /// One row per distinct (user, job, matcherVersion, canonical input set) — see `inputHash`.
  @@unique([userId, jobId, matcherVersion, inputHash], map: "one_match_per_user_job_input")
  /// SRS 5.6 "Recommended indexes": JobMatch(userId, score).
  @@index([userId, score], map: "job_matches_userId_score_idx")
  @@map("job_matches")
}

// ---------------------------------------------------------------------------
// M3 tables: notification outbox and feedback (SRS 3.2, 4.8, 5.2; FR-016,
// FR-017, FR-018; ENG-027, AC-015/016/017).
//
// Persistence only: nothing writes these rows yet. The gate is
// `evaluateNotificationEligibility` (@domain/notification), and the writer is the
// next increment — ENG-027 requires the match row and its outbox row in one
// transaction, so the two inserts cannot be designed independently. Delivery,
// Telegram credentials and the link token are later still.
// ---------------------------------------------------------------------------

model NotificationOutbox {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  jobId  String @db.Uuid
  /// The stored match this notification announces. Nullable because SRS 3.5 lets a
  /// notification policy permit informational listings that have no match.
  jobMatchId String? @db.Uuid

  /// SRS 5.2 `notificationType` (v1: `NEW_MATCH`).
  notificationType String
  /// The event within that type (v1: `NEW_MATCH`). With user, job and type this is the
  /// ENG-027 event key: an equivalent event is never inserted twice.
  event String

  /// SRS 5.2 `payload`: the rendered SRS 3.2 content, stored at reservation time so the
  /// delivered message does not depend on what the job row says later.
  payload Json

  status        NotificationStatus @default(PENDING)
  attemptCount  Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  lastError     String?
  createdAt     DateTime           @default(now())
  sentAt        DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobMatch JobMatch? @relation(fields: [jobMatchId], references: [id], onDelete: SetNull)
  feedback NotificationFeedback[]

  /// ENG-027 / AC-016: one row per equivalent event, enforced by the database rather
  /// than by a read-then-write check. Guarded by tests/integration/partial-indexes.spec.ts
  /// (plain unique: a partial index would let a second row in after the first was SENT).
  @@unique([userId, jobId, notificationType, event], map: "one_notification_per_event")
  /// SRS 5.6 "Recommended indexes": NotificationOutbox(status, nextAttemptAt) — the
  /// dispatcher's due-scan.
  @@index([status, nextAttemptAt], map: "notification_outbox_status_nextAttemptAt_idx")
  @@map("notification_outbox")
}

model NotificationFeedback {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String                    @db.Uuid
  /// SRS 4.8 / FR-018: relevant | not relevant | unsure. `NOT_RELEVANT` is the
  /// user's rejection and suppresses that job from further notification (SRS 3.2).
  value          NotificationFeedbackValue
  createdAt      DateTime                  @default(now())

  notification NotificationOutbox @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  /// One verdict per notification: feedback replaces the previous verdict (upsert) so a
  /// changed mind does not accumulate contradicting rows.
  @@unique([notificationId], map: "one_feedback_per_notification")
  @@map("notification_feedback")
}
